---
import { Image } from "astro:assets";
import aboutImg from "@/assets/about-duck.png";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";

const meta = {
	description: "I'm a beginner for this theme",
	title: "About",
};
---

<PageLayout meta={meta}>
	<div class="space-y-6">
		<h1 class="title">About</h1>
		<!-- 직접 그린 이미지 -->
		<div class="flex justify-center">
			<Image src={aboutImg} alt="ducking duck" loading="eager" fetchpriority="high" />
		</div>

		<p>Hi, I’m a beginner for Astro. {siteConfig.author}</p>
	</div>
</PageLayout>
