{
	"name": "my-small-recipe-book",
	"version": "1.5.1",
	"description": "my small recipe book",
	"author": "N-ISOGE",
	"scripts": {
		"postinstall": "npm rebuild sharp --force",
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"check": "astro check && biome check",
		"lint": "biome check --write",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^6.3.11",
		"@astrojs/mdx": "4.3.14",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "5.18.2",
		"astro-expressive-code": "^0.41.7",
		"astro-icon": "^1.2.0",
		"astro-rehype-relative-markdown-links": "^0.18.1",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"cssnano": "^7.1.9",
		"hastscript": "^9.0.1",
		"mdast-util-directive": "^3.1.1",
		"mdast-util-to-markdown": "^2.2.0",
		"mdast-util-to-string": "^4.0.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"satori": "0.19.3",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.5",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15",
		"@iconify-json/mdi": "^1.2.3",
		"@pagefind/default-ui": "^1.5.2",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"autoprefixer": "^10.6.1",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"reading-time": "^1.5.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "@tailwindcss/oxide", "esbuild", "sharp"],
		"overrides": {
			"sharp": "^0.35.5",
			"postcss-selector-parser": "^7.1.6",
			"esbuild": "^0.28.1"
		}
	},
	"overrides": {
		"sharp": "^0.35.5"
	}
}
